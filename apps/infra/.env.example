# ============================================================
# AstroQuest City - env vars (template)
#
# NE PAS ECRASER CE FICHIER .env.example
# C'est le template ; le vrai fichier est .env (gitignored).
#
# Pour ajouter/modifier une cle :
#   powershell -File apps\infra\scripts\set-secret.ps1 -Key MA_CLE -Value "ma_valeur"
# Pour lister les cles :
#   powershell -File apps\infra\scripts\show-env.ps1
# Pour retirer une cle :
#   powershell -File apps\infra\scripts\unset-secret.ps1 -Key MA_CLE
# ============================================================

# === LiteLLM auth (genere par bootstrap-env.ps1) ===
LITELLM_MASTER_KEY=sk-CHANGE_ME
LITELLM_SALT_KEY=sk-CHANGE_ME

# === PostgreSQL (genere par bootstrap-env.ps1) ===
POSTGRES_PASSWORD=CHANGE_ME

# ============================================================
# PROVIDERS
# Ajoute ici chaque provider au fur et a mesure (sans toucher a l'existant)
# ============================================================

# === MiniMax Token Plan (Code Plan, sk-cp-...) ===
MINIMAX_API_KEY=sk-cp-XXXXXX

# === Groq : pool de 21 cles (et plus si tu en as) ===
# Initial : genere par setup-keys.sh depuis keys.txt
# Pour ajouter une cle au dela de 21 :
#   powershell -File apps\infra\scripts\add-groq-key.ps1 -Value "gsk_..."
GROQ_KEY_01=gsk_XXXXXX
GROQ_KEY_02=gsk_XXXXXX
GROQ_KEY_03=gsk_XXXXXX
GROQ_KEY_04=gsk_XXXXXX
GROQ_KEY_05=gsk_XXXXXX
GROQ_KEY_06=gsk_XXXXXX
GROQ_KEY_07=gsk_XXXXXX
GROQ_KEY_08=gsk_XXXXXX
GROQ_KEY_09=gsk_XXXXXX
GROQ_KEY_10=gsk_XXXXXX
GROQ_KEY_11=gsk_XXXXXX
GROQ_KEY_12=gsk_XXXXXX
GROQ_KEY_13=gsk_XXXXXX
GROQ_KEY_14=gsk_XXXXXX
GROQ_KEY_15=gsk_XXXXXX
GROQ_KEY_16=gsk_XXXXXX
GROQ_KEY_17=gsk_XXXXXX
GROQ_KEY_18=gsk_XXXXXX
GROQ_KEY_19=gsk_XXXXXX
GROQ_KEY_20=gsk_XXXXXX
GROQ_KEY_21=gsk_XXXXXX

# === Mistral (optionnel) - Experiment tier ~1B tokens/mois gratuit ===
# MISTRAL_API_KEY=

# === Cloudflare Workers AI (optionnel) - 10K neurones/jour ===
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# === OpenRouter (optionnel) - 20 RPM / 50 RPD gratuit ===
# OPENROUTER_API_KEY=

# ============================================================
# PHASE 2 (provider payants, a venir)
# Decommenter quand tu auras la cle
# ============================================================
# === Anthropic (Claude Sonnet/Opus) ===
# ANTHROPIC_API_KEY=
# === Google Gemini Pro ===
# GEMINI_API_KEY=
# === OpenAI direct ===
# OPENAI_API_KEY=