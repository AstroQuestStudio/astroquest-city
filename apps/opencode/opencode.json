{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "aq-litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AstroQuest LiteLLM (Groq + MiniMax)",
      "options": {
        "baseURL": "http://127.0.0.1:4000/v1",
        "apiKey": "REPLACE_WITH_LITELLM_KEY"
      },
      "models": {
        "tier-7-fast": {
          "name": "MiniMax M3 (fast, minimal reasoning)"
        },
        "tier-6-ouvrier": {
          "name": "MiniMax M2.7 (low reasoning)"
        },
        "tier-4-groq": {
          "name": "Groq gpt-oss-120b (free)"
        },
        "tier-3-formatteur": {
          "name": "Groq gpt-oss-20b (super fast)"
        }
      }
    }
  },
  "model": "aq-litellm:tier-4-groq",
  "small_model": "aq-litellm:tier-3-formatteur",
  "agent": {
    "build": {
      "model": "aq-litellm:tier-7-fast",
      "prompt": "{file:./prompts/build.txt}"
    },
    "plan": {
      "model": "aq-litellm:tier-6-ouvrier",
      "prompt": "{file:./prompts/plan.txt}"
    }
  }
}